from sklearn.tree import DecisionTreeClassifier

# Training dataset
X = [
    [90, 42, 43, 20, 80, 6.5, 200],
    [85, 58, 41, 22, 82, 6.2, 180],
    [60, 55, 44, 25, 70, 6.8, 100],
    [30, 30, 30, 28, 60, 7.0, 80],
    [20, 25, 20, 30, 50, 6.5, 60],
    [40, 40, 40, 24, 65, 6.7, 120]
]

y = [
    "Rice", "Rice", "Wheat",
    "Millet", "Groundnut", "Maize"
]

# Train the model
model = DecisionTreeClassifier(random_state=0)
model.fit(X, y)

# Get input
N = float(input("Enter Nitrogen: "))
P = float(input("Enter Phosphorus: "))
K = float(input("Enter Potassium: "))
T = float(input("Enter Temperature: "))
H = float(input("Enter Humidity: "))
ph = float(input("Enter soil pH: "))
R = float(input("Enter Rainfall: "))

# Predict crop
crop = model.predict([[N, P, K, T, H, ph, R]])

print("Recommended Crop:", crop[0])
